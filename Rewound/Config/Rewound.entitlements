<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Without this key registerForRemoteNotifications fails outright with
	     "no valid aps-environment entitlement", so the app never gets a token.
	     "development" is what a locally signed build needs; automatic signing
	     rewrites it to "production" for a TestFlight or App Store archive. -->
	<key>aps-environment</key>
	<string>development</string>

	<!-- Sign in with Apple. Guideline 4.8 requires a privacy-preserving login
	     wherever a third-party one is offered, and AuthGateSheet offers Google,
	     so this is not optional for App Store review.

	     AppleSignInButton has always been complete; it failed at runtime with
	     ASAuthorizationError.unknown purely because this entitlement was absent
	     — the file used to say "no paid team", which stopped being true when
	     the app moved onto team KVXR84LZH3. The matching capability is enabled
	     on the com.shoprewound.rewound App ID as a primary App ID. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>

	<!-- Apple Pay. Exactly the same story as Sign in with Apple above: the
	     button has always rendered, because APPLE_PAY_ENABLED is YES in both
	     xcconfigs, and PassKit refused to open the sheet on a device because no
	     provisioning profile granted this merchant. The tap simply did nothing.

	     This entitlement can only be signed by a paid team, which is why the
	     file used to omit it — that reasoning died with the move to team
	     KVXR84LZH3. The merchant id must be created on that team and enabled as
	     a capability on the com.shoprewound.rewound App ID, and the same
	     merchant id must be paired with a payment-processing certificate in
	     Stripe, before a real payment can complete. Without the portal half the
	     sheet still will not open; with it, StripeSupport's
	     applePayMerchantID is the string that has to match. -->
	<key>com.apple.developer.in-app-payments</key>
	<array>
		<string>merchant.com.shoprewound.rewound</string>
	</array>
</dict>
</plist>
