// Local development — the simulator shares the Mac's loopback interface, while
// a physical device reaches the same backend over the LAN. Plaintext to a
// private address is admitted by NSAllowsLocalNetworking in Info.plist, so the
// device build needs no tunnel and no certificate. If the Mac's IP moves,
// re-check `ipconfig getifaddr en0` — the previous quick tunnel here had gone
// dead and was still pointed at the retired :8000 compose stack.
// Routes are served at the origin root (no /api prefix).
API_BASE_URL[sdk=iphonesimulator*] = http:/$()/localhost:8010
API_BASE_URL[sdk=iphoneos*] = http:/$()/192.168.86.22:8010

// calibre-messaging — a separate service (buyer↔seller messaging + the
// contact guard), own port, own dev process. Same simulator/device split as
// API_BASE_URL above, same reason.
MESSAGING_API_BASE_URL[sdk=iphonesimulator*] = http:/$()/localhost:8020
MESSAGING_API_BASE_URL[sdk=iphoneos*] = http:/$()/192.168.86.22:8020

SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG

// Shows Apple Pay in the payment sheet. Completing one additionally needs the
// com.apple.developer.in-app-payments entitlement and merchant id
// merchant.com.buycalibre.calibre registered to a *paid* Apple Developer
// account. Until that exists, Apple Pay works in the Simulator and fails at
// authorization on a sideloaded device — the entitlement is deliberately not
// in Calibre.entitlements, because a free-Apple-ID re-sign can't carry it.
APPLE_PAY_ENABLED = YES

// Product analytics (PostHog). Deliberately EMPTY in the tracked config — an
// empty key disables analytics entirely: the SDK is never configured and every
// capture is a no-op. Supply a real project key in a local override or CI
// build setting to turn it on. The host has a working default because it is
// not a secret; only the key gates the feature.
CALIBRE_POSTHOG_KEY =
CALIBRE_POSTHOG_HOST = https:/$()/us.i.posthog.com
